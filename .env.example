# ---------------------------------------------------------------------------
# Deployment-level settings only. `make env` copies this to .env and fills in
# CREDENTIALS_ENCRYPTION_KEYS and JWT_SECRET.
#
# Model/speech provider API keys are NOT configured here: each tenant enters
# their own keys in the app (Settings -> Models), stored encrypted (ADR 0004).
#
# The same .env serves both ways of running:
# - docker compose: reads the values below; addresses between containers
#   (database, backend) are fixed in docker-compose.yml, so DATABASE_URL and
#   BACKEND_URL here are ignored by the containers.
# - backend/frontend on the host (make dev-*): uses the localhost URLs below.
# ---------------------------------------------------------------------------

# App: dev | prod. prod requires a JWT_SECRET of 32+ bytes and serves the auth
# cookie as Secure (HTTPS only), so put an HTTPS reverse proxy in front.
APP_ENV=dev
# Relative paths resolve against the repo root
PROVIDERS_CONFIG=config/providers.dev.yaml

# Auth
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=10080

# Encryption keys for tenant credentials: "id:base64key[,id:base64key...]".
# The first key encrypts; all keys decrypt (for rotation: make rotate-credentials).
# Generate: make gen-key. Losing it makes stored API keys unreadable.
CREDENTIALS_ENCRYPTION_KEYS=

# Allow tenant-provided base_urls on private/loopback networks (e.g. local Ollama).
# Keep false for any server exposed to other users (SSRF protection).
# In docker compose, reach a model server on the host via http://host.docker.internal:<port>/v1
# (the "ollama" preset's localhost URL points at the backend container itself);
# the host service must listen beyond 127.0.0.1, e.g. OLLAMA_HOST=0.0.0.0.
PROVIDER_ALLOW_PRIVATE_NETWORKS=false

# After each reply, extract long-term memories with one extra model call on the tenant's
# `reflect` route (ADR 0009). false = no new memories; existing ones are still used.
MEMORY_REFLECTION_ENABLED=true

# Postgres (used by the compose postgres service and the compose backend)
POSTGRES_USER=lingo
POSTGRES_PASSWORD=lingo
POSTGRES_DB=lingo
# Host port of the compose postgres (container port is always 5432; bound to 127.0.0.1)
POSTGRES_HOST_PORT=5433
# For a backend running on the host; must match the POSTGRES_* values above
DATABASE_URL=postgresql+psycopg://lingo:lingo@localhost:5433/lingo
# Connections reserved for LangGraph's conversation checkpointer
CHECKPOINT_POOL_MAX_SIZE=4

# Published ports of the compose stack. The frontend is the only public entry;
# the backend port is bound to 127.0.0.1 (for debugging the API directly).
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=8000
# Where a host-run frontend (make dev-frontend) proxies /api. Read at `next build`
# time for the rewrites, so rebuild after changing it.
BACKEND_URL=http://localhost:8000

# Local speech-to-text for dev (compose profile `asr`, `make asr-up`; ADR 0008 §5).
# Then add a connection in Settings from the "Speaches" preset (base URL
# http://localhost:8200/v1 for a host-run backend, http://asr:8000/v1 for the compose
# backend; needs PROVIDER_ALLOW_PRIVATE_NETWORKS=true) and put
# speaches:Systran/faster-whisper-small on the speech-to-text route.
# Uses ~260MB idle and ~1.4GB while transcribing; the image is ~3.4GB.
ASR_HOST_PORT=8200
ASR_MODEL=Systran/faster-whisper-small
# Where models are downloaded from. The container can't use a proxy bound to the
# host's 127.0.0.1; if huggingface.co is unreachable, use https://hf-mirror.com.
ASR_HF_ENDPOINT=https://huggingface.co

# Where `make vocab-import` downloads the ECDICT word list from (runs on the host).
# Empty = the pinned GitHub copy. A mirror must serve the same file (sha256 is checked).
ECDICT_URL=

# Not used in P0; for the optional compose profiles (--profile neo4j / --profile redis)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Observability (ADR 0005) - off by default.
# Traces contain full conversation content: if you point this at a third-party
# service, conversations leave your server.
OTEL_TRACING_ENABLED=false
# Local Phoenix: docker compose --profile observability up -d
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006/v1/traces
# Same, as seen from the compose backend container (default: the phoenix service)
COMPOSE_OTEL_EXPORTER_OTLP_ENDPOINT=http://phoenix:6006/v1/traces
